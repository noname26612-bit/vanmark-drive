// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Роли (ARCHITECTURE §4). Источник правды по правам — только сессия, см. §6.
// SERVICE_MANAGER (05.08.2026) — менеджер-сервисник: ТОЛЬКО модуль станков (§4г, PRD §16).
// Задач, KPI, смен, сводок и админки не видит. Права строятся белыми списками ролей,
// никогда «всё кроме DRIVER» — иначе новая роль пролезает в чужие разделы.
enum Role {
  ADMIN
  DISPATCHER
  DRIVER
  SERVICE_MANAGER
}

// Статусы задачи (ARCHITECTURE §5). Переходы — только через матрицу в src/domain/task-status.ts.
// Переработка механики водителя (этап A): рабочая цепочка схлопнута в IN_PROGRESS «В работе»
// (объединяет прежние ACCEPTED+EN_ROUTE+ON_SITE). ACCEPTED/EN_ROUTE/ON_SITE — LEGACY: новым задачам
// не назначаются, оставлены в enum ради чтения неизменяемого журнала TaskEvent (CLAUDE.md правило 3).
enum TaskStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  ACCEPTED // legacy (до этапа A)
  EN_ROUTE // legacy (до этапа A)
  ON_SITE // legacy (до этапа A)
  DONE
  ON_HOLD
  RESCHEDULED
  CANCELLED
}

// Статус пропуска на объект (PRD §6).
enum PassStatus {
  NOT_NEEDED
  NEEDED
  ORDERED
}

// Оплата (PRD §4): нет / через офис / на месте.
enum PaymentType {
  NONE
  OFFICE
  ON_SITE
}

// Вид вложения (ARCHITECTURE §4). Фото — отчётные и приложенные при постановке.
enum AttachmentKind {
  PHOTO
  DOCUMENT
}

// Состояние ведомости работ (этап 12, PRD §13.4). На задаче null — ведомость не нужна
// (тип без requiresPricing). Жизненный цикл живёт отдельно от статуса задачи.
enum WorksheetStatus {
  DRAFT // водитель заполняет
  PRICING // отправлена диспетчеру на расценку (этап 13)
  PRICED // цены проставлены (этап 13)
  SIGNED // подписанный акт приложен (этап 14)
}

// Смена водителя (этап C, переработка механики). Водитель «открывает смену» (фактическое начало дня) →
// диспетчер подтверждает приход (он физически на базе) → водитель «закрывает смену» (конец дня).
enum ShiftStatus {
  REQUESTED // открыта водителем, ждёт подтверждения диспетчера
  OPEN // диспетчер подтвердил — смена идёт
  CLOSED // водитель закрыл смену
}

// Тип отсутствия водителя (№9, решение Артёма 23.06): отпуск / больничный / прочее.
enum AbsenceType {
  VACATION // отпуск
  SICK // больничный
  OTHER // прочее (отгул и т.п.)
}

model User {
  id             String               @id @default(uuid())
  login          String               @unique // латиница, вводится при входе
  passwordHash   String // argon2id, см. src/lib/password.ts
  name           String // «Милена», «Алексей Писарев»
  // Должность для отображения в шапке (напр. «Директор» у Михаила при role=ADMIN). НЕ право:
  // права определяет role. null → подпись берётся по роли (roleLabel). Решение Артёма 23.06.2026.
  position       String?
  phone          String?
  role           Role
  isActive       Boolean              @default(true)
  canLogin       Boolean              @default(true) // false — вход запрещён (админ включает осознанно)
  // Внешний (наёмный) исполнитель — надёжный признак вместо прежнего «canLogin=false» (02.07.2026):
  // без смен (SHIFT_REQUIRED не применяется), вне KPI (профиля нет), в заявке доступна стоимость
  // поездки (carrierCost, этап 3). Вход отдельным флагом canLogin — внешний может и входить.
  isExternal     Boolean              @default(false)
  // Ёмкость (Фаза 2, PRD §14.5): специализация для подсказки «кто свободен». Каширский REPAIR, Писарев/Султан DELIVERY.
  specialization DriverSpecialization @default(ANY)
  // Персональный доступ к разделам оборудования (Листогибы/Фальцепрокатники), решение Артёма
  // 15.08.2026 для Николая и Александра. Роль при этом остаётся DRIVER: задачи, смены и KPI
  // считаются как раньше. Это ЕДИНСТВЕННОЕ право, выданное не ролью, — поэтому доступ к модулю
  // проверяется предикатом «роль из белого списка ИЛИ этот флаг» (src/domain/machine-access.ts),
  // и флаг читается из БД, а не из сессии: включение действует сразу, без перезахода.
  equipmentAccess Boolean             @default(false)
  createdAt      DateTime             @default(now())

  tasks        Task[]             @relation("assignee")
  coTasks      Task[]             @relation("coDriver") // парные задачи, где этот водитель — напарник
  createdTasks Task[]             @relation("creator")
  events       TaskEvent[]
  pushSubs     PushSubscription[] // этап 5 (web-push): подписки устройств этого пользователя

  // KPI / зарплата (Фаза 1.5, ARCHITECTURE §4а)
  kpiMarks        KpiMark[]          @relation("kpiDriver") // отметки KPI этого водителя
  kpiCreatedMarks KpiMark[]          @relation("kpiCreatedBy") // ручные отметки, созданные этим диспетчером
  payProfile      DriverPayProfile?  @relation("payProfile") // денежный профиль (только водители)
  payStatements   PayrollStatement[] @relation("payStatements") // закрытые расчёты за месяцы
  uiPrefs         UiPreference[] // настройки интерфейса (раскладка доски/планирования)
  shifts          Shift[]            @relation("shiftDriver") // смены водителя (этап C)
  absences        DriverAbsence[]    @relation("driverAbsence") // отпуска/больничные водителя (№9)
  idleNotes       DriverIdleNote[]   @relation("idleNoteDriver") // пометки диспетчера о простое (02.07)

  // Модуль «Станки» (§4г, PRD §16)
  machinesResponsible Machine[]      @relation("machineResponsible") // станки, где этот менеджер — ответственный
  machinesCreated     Machine[]      @relation("machineCreator") // станки, заведённые этим пользователем
  machineEvents       MachineEvent[] @relation("machineEventActor") // записи в журналах станков
}

// Справочник типов задач (PRD §3). Новые типы заводит админ без правки кода.
model TaskType {
  id                String  @id @default(uuid())
  name              String  @unique // «Доставка / забор из аренды», «Выездной ремонт / диагностика»...
  icon              String? // имя иконки lucide
  requiresPhoto     Boolean @default(true) // DEPRECATED (этап 11): фото при DONE НЕ обязательно (решение Артёма). Поле НЕ гейт; оставлено для совместимости данных. См. CLAUDE.md правило 4.
  // Ремонтный тип: ожидается подписанный акт (документ-вложение). НЕ гейт завершения —
  // отсутствие = нарушение KPI UNSIGNED_DOCS (Фаза 1.5, PRD §12.1). См. src/domain/kpi.ts.
  requiresSignedDoc Boolean @default(false)
  // Нужна ли ведомость работ + расценка (этап 12, PRD §13): выездной ремонт/диагностика, гарантия.
  // Акты-описи (аренда/забор) ведомость не используют, поэтому это отдельный флаг от requiresSignedDoc.
  requiresPricing   Boolean @default(false)
  // Ёмкость (Фаза 2, PRD §14.2): норма работы на объекте, мин (сверх времени на дорогу).
  onSiteMinutes     Int     @default(30)
  sortOrder         Int     @default(0)
  isActive          Boolean @default(true)
  tasks             Task[]
}

model Task {
  id     String @id @default(uuid())
  // Сквозной номер: Postgres sequence task_number_seq (START 476 — миграция). См. ARCHITECTURE §4.
  number Int    @unique @default(dbgenerated("nextval('task_number_seq'::regclass)"))

  typeId String
  type   TaskType @relation(fields: [typeId], references: [id])

  // Требование подписанного акта НА УРОВНЕ ЗАДАЧИ (этап 11, PRD §4): снимок дефолта из
  // type.requiresSignedDoc при создании; диспетчер может снять галочкой «акт не нужен»
  // (actWaivedNote — причина, напр. «подпишут по ЭДО»). Источник для KPI UNSIGNED_DOCS — теперь
  // это поле, не type (см. src/domain/kpi-service.ts). НЕ гейт завершения (PRD §5).
  requiresSignedDoc Boolean          @default(false)
  actWaivedNote     String? // причина снятия требования акта на этой заявке
  // Ведомость работ (этап 12): null — не нужна (тип без requiresPricing); иначе DRAFT→PRICING→PRICED→SIGNED.
  worksheetStatus   WorksheetStatus?

  title            String // «ЛБМ 200 + нож + дог. маш, 0,7 мм»
  description      String?     @db.Text
  equipment        String? // «ЛБМ 250», «Sorex 2 м»
  orgName          String? // «ДОМОСТРОЙ ЛОГИСТИК ООО»
  contactName      String?
  contactPhone     String?
  address          String
  addressLink      String? // deeplink Яндекс/2ГИС
  invoiceNumber    String? // «948», «261»
  paymentType      PaymentType @default(NONE)
  paymentAmount    Int? // «доставка 5000 водителю»
  paymentNote      String?
  // Факт оплаты при завершении ON_SITE-задачи (№8, решение Артёма 23.06): true — деньги получены,
  // false — завершена без оплаты (с причиной paymentMissedReason), null — не относится / нет данных.
  paymentReceived     Boolean?
  paymentMissedReason String? // причина неоплаты (типовой вариант или свой текст), если paymentReceived=false
  // Причина, выбранная водителем при завершении актовой задачи без акта (акты до 20:00, PRD §12.1).
  // Чисто информационная: кандидат UNSIGNED_DOCS создаётся независимо, Милена видит причину и решает.
  actMissedReason     String?
  // Стоимость поездки для компании, ₽ (этап 3, 02.07): сколько платим внешнему перевозчику за эту
  // задачу. Вводит диспетчер (поле в форме видно при внешнем исполнителе). ВОДИТЕЛЯМ НЕ ОТДАЁТСЯ
  // (stripMoneyForDriver в task-service). Источник отчёта затрат в Сводке.
  carrierCost         Int?
  scheduledDate    DateTime?   @db.Date // null — пул «Без даты»
  timeFrom         String? // «09:00»
  timeTo           String? // «17:00»
  timeNote         String? // «после обеда»
  // Ёмкость и оценка времени (Фаза 2, PRD §14). lat/lng — геокод адреса при создании/правке
  // (src/lib/geocode.ts); null — геокод не удался (оценка считается без дороги).
  lat              Float?
  lng              Float?
  estimatedMinutes Int? // оценка времени, мин (норма типа + дорога); null — не посчитана
  estimateIsManual Boolean     @default(false) // диспетчер задал оценку вручную → не пересчитывать
  passStatus       PassStatus  @default(NOT_NEEDED)
  priority         Boolean     @default(false) // срочная
  status           TaskStatus  @default(NEW)

  assigneeId  String?
  assignee    User?   @relation("assignee", fields: [assigneeId], references: [id])
  // Напарник — второй водитель на парном выезде (20.07.2026, PRD §4). Существует только при
  // назначенном ответственном (coDriverId != null => assigneeId != null, coDriverId != assigneeId,
  // инвариант держит домен). Статусы/деньги/акты/KPI — на ответственном; напарник видит задачу,
  // шлёт фото и комментарии, занятость учитывается обоим.
  coDriverId  String?
  coDriver    User?   @relation("coDriver", fields: [coDriverId], references: [id])
  createdById String
  createdBy   User    @relation("creator", fields: [createdById], references: [id])

  cancelReason String?
  holdReason   String?

  // Архив заявки (11.08.2026): мягкое удаление для дублей и ошибочно заведённых заявок. Не статус
  // (матрица §5 не менялась) и не удаление: строка и её журнал остаются, номер не переиспользуется.
  // Архивная заявка исчезает из всех рабочих выборок и из аналитики; вернуть её может тот же, кто
  // ведёт заявки (isTaskManagerRole). archivedById — кто убрал (uuid без навигации, как принято).
  archivedAt   DateTime?
  archivedById String?

  events      TaskEvent[]
  attachments Attachment[]
  workItems   WorkItem[] // позиции ведомости работ (этап 12)
  kpiMarks    KpiMark[] // отметки KPI, привязанные к этой задаче (Фаза 1.5)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([assigneeId, scheduledDate])
  @@index([coDriverId, scheduledDate])
  @@index([status, scheduledDate])
  @@index([archivedAt])
}

// Неизменяемый журнал событий (CLAUDE.md правило 3): только на запись, не редактируется и не удаляется.
model TaskEvent {
  id         String      @id @default(uuid())
  taskId     String
  task       Task        @relation(fields: [taskId], references: [id])
  actorId    String
  actor      User        @relation(fields: [actorId], references: [id])
  kind       String // status_change | comment | edit | assign | reschedule | created
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  comment    String?
  lat        Float?
  lng        Float?
  at         DateTime    @default(now())

  @@index([taskId, at])
}

// Вложения задачи (ARCHITECTURE §4, §6). Фото-отчёты исполнителя и вложения диспетчера при
// постановке различаются по createdById. Файлы лежат в UPLOADS_DIR (vol), путь — серверный
// uuid.ext (клиент имя не задаёт). Раздача — только через GET /api/attachments/:id с проверкой
// прав, не из public/. Привязка к задаче определяет, кто имеет доступ (та же изоляция).
model Attachment {
  id          String         @id @default(uuid())
  taskId      String
  task        Task           @relation(fields: [taskId], references: [id])
  kind        AttachmentKind @default(PHOTO)
  filePath    String // относительный путь в UPLOADS_DIR (uuid.ext) — генерит сервер
  mimeType    String
  sizeBytes   Int
  createdById String // кто загрузил: отчётные — исполнитель (assignee), при постановке — диспетчер
  lat         Float?
  lng         Float?
  createdAt   DateTime       @default(now())

  @@index([taskId, createdAt])
}

// Раздел справочника работ (группа услуг/товаров). Наполняет админ; позиции группируются по
// разделам в выборе у водителя и в админке. Позиция может быть без раздела (categoryId=null).
model WorkCategory {
  id        String            @id @default(uuid())
  name      String            @unique // «Услуги», «Запчасти / товары»...
  sortOrder Int               @default(0)
  isActive  Boolean           @default(true)
  items     WorkCatalogItem[]
}

// Справочник работ для ведомости (этап 12, PRD §13.3). Наполняет админ. Цены-подсказки — этап 13.
model WorkCatalogItem {
  id           String        @id @default(uuid())
  name         String        @unique // «Диагностика», «Замена ножа»...
  defaultPrice Int? // подсказка цены за единицу, ₽ (этап 13); диспетчер правит при расценке
  categoryId   String? // раздел справочника (группа); null — без раздела
  category     WorkCategory? @relation(fields: [categoryId], references: [id])
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  workItems    WorkItem[]
}

// Позиция ведомости выполненных работ (этап 12, PRD §13.1). Водитель фиксирует ЧТО сделал и
// количество — БЕЗ цен. Цену проставляет диспетчер при расценке (этап 13). Меняется водителем
// только пока worksheetStatus=DRAFT. catalogItemId=null — свободная строка (работы нет в справочнике).
model WorkItem {
  id            String           @id @default(uuid())
  taskId        String
  task          Task             @relation(fields: [taskId], references: [id])
  catalogItemId String?
  catalogItem   WorkCatalogItem? @relation(fields: [catalogItemId], references: [id])
  name          String // снимок названия работы (из справочника или свободный ввод)
  quantity      Int              @default(1)
  price         Int? // цена за единицу, ₽ (этап 13): null пока диспетчер не расценил
  sortOrder     Int              @default(0)
  createdById   String // водитель, заполнивший позицию
  createdAt     DateTime         @default(now())

  @@index([taskId, sortOrder])
}

// Подписка устройства на web-push (ARCHITECTURE §4, §8). Одна запись = один браузер/устройство
// пользователя. endpoint уникален. Протухшие подписки (HTTP 404/410 при отправке) сервис удаляет.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String // ключ шифрования из subscription.keys.p256dh
  auth      String // ключ аутентификации из subscription.keys.auth
  userAgent String? // для отладки/опознания устройства
  createdAt DateTime @default(now())

  @@index([userId])
}

// Смена водителя (этап C). «Открыть смену» фиксирует фактическое начало рабочего дня (момент нажатия
// водителя), диспетчер подтверждает приход (он на базе). «Закрыть смену» — конец дня. Одна смена на
// водителя в день. Время начала/конца — основа учёта отработанного и простоя (этап D). Изоляция как у
// задач: driverId берётся ТОЛЬКО из сессии (CLAUDE.md правило 1). confirmedById — uuid без навигации.
model Shift {
  id            String      @id @default(uuid())
  driverId      String
  driver        User        @relation("shiftDriver", fields: [driverId], references: [id])
  date          DateTime    @db.Date // рабочий день — локальная дата открытия (МСК)
  status        ShiftStatus @default(REQUESTED)
  openedAt      DateTime // фактическое время начала смены; может быть скорректировано диспетчером/админом (№3)
  // Корректировка времени открытия (№3, решение Артёма 23.06): на случай «не было связи / сел телефон».
  // В openedAt держим АКТУАЛЬНОЕ (исправленное) — KPI/учёт считают по нему; здесь — аудит правки.
  openedAtReported     DateTime? // исходное время (что нажал водитель), снимок до первой правки; null = не правили
  openedAtAdjustedById String? // кто поправил (диспетчер/админ), uuid без навигации
  openedAtAdjustedAt   DateTime?
  openedAtAdjustNote   String? // причина правки (напр. «не было связи»)
  // Смена открыта офлайн (O7): openedAt зафиксирован временем телефона (X-Occurred-At из очереди досылки),
  // а не сервером. Милена видит пометку и при подтверждении может поправить время (№3).
  openedOffline Boolean @default(false)
  confirmedById String? // диспетчер, подтвердивший открытие
  confirmedAt   DateTime?
  closedAt      DateTime?
  // Закрытие смены диспетчером/директором/админом (№2, 03.07): кто закрыл смену за водителя (uuid без
  // навигации). null — закрыл сам водитель (или ещё не закрыта). Аудит, не право.
  closedById    String?
  // Корректировка времени ЗАКРЫТИЯ (№3, 03.07) — зеркало правки openedAt. Закрытие влияет на «отработано/
  // простой» в Сводке, поэтому правим с обязательной причиной и запрещаем в закрытом месяце. В closedAt
  // держим АКТУАЛЬНОЕ (исправленное) время; reported — снимок исходного до первой правки (null = не правили).
  closedAtReported     DateTime?
  closedAtAdjustedById String? // кто поправил время закрытия (диспетчер/админ), uuid без навигации
  closedAtAdjustedAt   DateTime?
  closedAtAdjustNote   String? // причина правки времени закрытия
  // Ручная коррекция авто-простоя смены (решение Артёма 07.07). Полоса «В работе / Простой» на доске
  // и в Сводке считается автоматически: простой = длина смены − время задач «В работе». Если водитель
  // работал, но не взял задачу в работу (сел телефон), система ошибочно засчитывает простой. Диспетчер
  // может задать ФАКТИЧЕСКИЙ простой вручную — с обязательной причиной, запрет в закрытом месяце.
  // null = считать автоматически (по умолчанию). Влияет и на доску, и на Сводку (деньги за простой).
  idleMinutesOverride Int? // фактический простой смены, мин (0..720); null = авто-расчёт
  idleOverrideById    String? // кто скорректировал (диспетчер/админ), uuid без навигации
  idleOverrideAt      DateTime?
  idleOverrideNote    String? // причина коррекции (обязательна при установке значения)
  createdAt     DateTime    @default(now())
  kpiMarks      KpiMark[] // отметки KPI по смене (SHIFT_LATE, этап D)

  @@unique([driverId, date]) // одна смена на водителя в день
  @@index([date, status])
}

// Отсутствие водителя (№9, решение Артёма 23.06): отпуск/больничный/прочее на диапазон дат.
// Заводят админ и диспетчер. Влияет на Календарь загрузки (дни «гасятся») и KPI (в отпуск не штрафуем
// «невыполненную точку»). driverId — за другого (исключение из изоляции): валидируется как DRIVER в сервисе.
model DriverAbsence {
  id          String      @id @default(uuid())
  driverId    String
  driver      User        @relation("driverAbsence", fields: [driverId], references: [id])
  dateFrom    DateTime    @db.Date // включительно
  dateTo      DateTime    @db.Date // включительно
  type        AbsenceType @default(VACATION)
  note        String?
  createdById String? // кто завёл (uuid без навигации, как принято)
  createdAt   DateTime    @default(now())

  @@index([driverId, dateFrom])
  @@index([dateFrom, dateTo])
}

// Пометка диспетчера о простое водителя (решение Артёма 02.07): «смену открыл в 9:00, на точке был
// в 10:30 — 90 мин простоя». Реестр (можно удалять, пока не оштрафовано), НЕ журнал. Водителю НЕ
// видна ни в одном ответе — только диспетчер/админ (Сводка, доска). Привязка к дате+водителю (не к
// смене): пометку можно внести задним числом и она не ломается при переоткрытии смены. Из пометки
// одним действием создаётся ручной штраф KPI (MANUAL) — kpiMarkId связывает их; note штрафа —
// автотекст БЕЗ комментария Милены (note MANUAL водитель видит в «Мой расчёт»).
model DriverIdleNote {
  id          String   @id @default(uuid())
  driverId    String
  driver      User     @relation("idleNoteDriver", fields: [driverId], references: [id])
  date        DateTime @db.Date // день простоя (МСК-дата, как Shift.date)
  minutes     Int // длительность простоя, мин (1..720)
  note        String? // причина/комментарий Милены — водителю НЕ виден
  kpiMarkId   String?  @unique // созданный из пометки MANUAL-штраф; null — не штрафовали
  createdById String // диспетчер/админ (uuid без навигации, как принято)
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([driverId, date])
}

// ───────────────────────────── KPI и зарплата (Фаза 1.5) ─────────────────────────────
// Модель данных — ARCHITECTURE §4а, продукт — PRD §12. Всё аддитивно поверх Фазы 1.
// Принцип: зарплата = оклад + (премия − прогрессивные штрафы) + ручные поощрения; закрытый
// месяц фиксируется снимком (PayrollStatement) и больше не зависит от правок отметок/правил.

// Виды отметок KPI: 3 авто-метрики (детектор) + ручная отметка диспетчера.
enum KpiMarkKind {
  SHIFT_LATE // поздно открыл смену (этап D): openedAt позже порога 9:15. Заменяет LATE
  LATE // legacy: опоздание на объект (до этапа D); новых не создаётся, остаётся в истории
  UNSIGNED_DOCS // ремонтная задача завершена без подписанного акта (документ-вложения)
  MISSED_STOP // назначенная на день точка не доведена до DONE (без переноса/отмены)
  MANUAL // ручная отметка: штраф или поощрение (знаковая сумма в manualAmount)
}

// Жизненный цикл отметки: предложено системой → решение Милены. Ручные сразу CONFIRMED.
enum KpiMarkStatus {
  CANDIDATE
  CONFIRMED
  DISMISSED
}

// Нижний порог итога к выплате (решение Артёма, KPI-ответ 1): SALARY — штрафы максимум
// обнуляют премию, итог не ниже оклада. ZERO — премия может уйти в минус (итог не ниже 0).
enum PayoutFloor {
  SALARY
  ZERO
}

// Отметка KPI. Авто-кандидатов создаёт ночной детектор (cron), решение принимает диспетчер.
// Корректируемый реестр (в отличие от неизменяемого TaskEvent): пока месяц открыт, статус
// можно менять — каждое решение пишет resolvedById/resolvedAt. Закрытый месяц фиксируется
// снимком в PayrollStatement и больше не зависит от правок отметок (PRD §12.4).
model KpiMark {
  id           String        @id @default(uuid())
  driverId     String // чей KPI; изоляция водителя — по нему
  driver       User          @relation("kpiDriver", fields: [driverId], references: [id])
  taskId       String? // привязка к задаче (UNSIGNED_DOCS/MISSED_STOP); null — смена/ручная
  task         Task?         @relation(fields: [taskId], references: [id])
  shiftId      String? // привязка к смене (SHIFT_LATE, этап D); null — задачная/ручная
  shift        Shift?        @relation(fields: [shiftId], references: [id])
  period       String // месяц начисления «YYYY-MM» (по occurredAt в CRON_TZ)
  kind         KpiMarkKind
  status       KpiMarkStatus @default(CANDIDATE)
  occurredAt   DateTime // когда произошло — для прогрессии (порядок ошибок в месяце)
  note         String? // автоописание / пояснение диспетчера
  manualAmount Int? // только MANUAL: знаковая сумма ₽ (− штраф, + поощрение)
  createdById  String? // null — авто-кандидат от системы; иначе диспетчер (ручная)
  createdBy    User?         @relation("kpiCreatedBy", fields: [createdById], references: [id])
  resolvedById String? // кто подтвердил/отклонил (uuid, без навигации — см. §4а)
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())

  @@unique([taskId, kind]) // идемпотентность детектора: одна авто-отметка вида на задачу
  @@unique([shiftId, kind]) // идемпотентность детектора смен: одна SHIFT_LATE на смену (этап D)
  @@index([driverId, period])
  @@index([status, period])
}

// Денежный профиль водителя (оклад/премия задаёт админ). Веса штрафов — глобальные (KpiRule),
// шаг прогрессии и нижний порог — глобальные (KpiSettings).
model DriverPayProfile {
  id          String   @id @default(uuid())
  driverId    String   @unique
  driver      User     @relation("payProfile", fields: [driverId], references: [id])
  baseSalary  Int      @default(0) // оклад ₽/мес
  premiumBase Int      @default(0) // премия ₽ при нуле ошибок (полная «прибавка»)
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// Глобальный вес штрафа по виду нарушения (по строке на авто-метрику). Настраивает админ.
model KpiRule {
  id       String      @id @default(uuid())
  kind     KpiMarkKind @unique
  weight   Int // базовый штраф ₽ за ошибку этого вида (до прогрессии)
  isActive Boolean     @default(true)
}

// Глобальные настройки расчёта (singleton, одна строка). Шаг прогрессии вынесен из константы
// в БД, потому что админ настраивает прогрессию в UI (PRD §8 экран 5, решение Артёма). Это
// осознанное уточнение ARCHITECTURE §4а («шаг прогрессии — константа») — зафиксировано в доке.
model KpiSettings {
  id                       String      @id @default("singleton") // ровно одна строка
  progressionPercent       Int         @default(110) // шаг прогрессии, % (110 = ×1.10 на каждую следующую ошибку)
  progressionStartIndex    Int         @default(3) // с какого по счёту нарушения месяца включается прогрессия
  floor                    PayoutFloor @default(SALARY) // нижний порог итога (решение Артёма)
  actBonusAmount           Int         @default(5000) // бонус за комплектность актов, ₽ (этап 15, PRD §12.6)
  actBonusThresholdPercent Int         @default(80) // порог комплектности актов для бонуса, % (этап 15)
  // Нормо-часы месяца для стоимости часа водителя (Сводка v2, 02.07): час = baseSalary / monthNormHours.
  // 176 = 8 ч × 22 рабочих дня. Используется ТОЛЬКО в аналитике «простой в рублях» (видна админу).
  monthNormHours           Int         @default(176)
  updatedAt                DateTime    @updatedAt
}

// Снимок расчёта за закрытый месяц (неизменяем). До закрытия расчёт считается на лету из
// CONFIRMED-отметок + правил + настроек. После закрытия — отдаётся этот снимок (PRD §12.4).
model PayrollStatement {
  id          String   @id @default(uuid())
  driverId    String
  driver      User     @relation("payStatements", fields: [driverId], references: [id])
  period      String // «YYYY-MM»
  baseSalary  Int // снимок оклада
  premiumBase Int // снимок премии
  penalty     Int // сумма штрафов (положительное число)
  bonus       Int // сумма ручных поощрений
  actBonus    Int      @default(0) // бонус за комплектность актов (этап 15, PRD §12.6): 0 или actBonusAmount
  actBase     Int      @default(0) // знаменатель: завершённые актовые задачи месяца (снимок)
  actComplete Int      @default(0) // числитель: из них с приложенным актом (снимок)
  total       Int // итог к выплате (не ниже нижнего порога; включает actBonus)
  breakdown   Json // детализация по отметкам на момент закрытия
  closedById  String // кто закрыл (uuid, без навигации)
  closedAt    DateTime @default(now())

  @@unique([driverId, period])
}

// ───────────────────────── Ёмкость и календарь загрузки (Фаза 2) ─────────────────────────
// Модель — ARCHITECTURE §4б, продукт — PRD §14. Аддитивно. Оценка времени задачи = норма типа
// (TaskType.onSiteMinutes) + дорога (haversine база→точка × петляние ÷ скорость × коэфф. пробок).
// Маршрут с живыми пробками не подключаем (PRD §14.6). Чистый расчёт — src/domain/capacity.ts.

// Специализация водителя для подсказки «кто свободен» (PRD §14.5). «Ремонтность» задачи берём из
// type.requiresPricing (выездной ремонт + гарантия); это поле — предпочтение водителя.
enum DriverSpecialization {
  REPAIR // выездные ремонты (Каширский)
  DELIVERY // доставки (Писарев, Султан)
  ANY // без выраженной специализации
}

// Глобальные настройки расчёта ёмкости (singleton, одна строка), как KpiSettings. Дефолты —
// данные Артёма 19.06.2026. Правит админ в UI.
model CapacitySettings {
  id              String   @id @default("singleton")
  baseLat         Float    @default(55.959611) // база: пос. Лесные Поляны, ул. Ленина 1Ас26
  baseLng         Float    @default(37.864076)
  workdayMinutes  Int      @default(480) // рабочий день минус обед (9–18 − 1 ч) — знаменатель загрузки
  avgSpeedKmh     Int      @default(50) // средняя скорость свободной дороги, км/ч; калибруется по факту
  detourPercent   Int      @default(110) // коэфф. петляния (110 = ×1.1)
  countReturnTrip Boolean  @default(false) // учитывать обратную дорогу (база→точка→база)
  // Смена (этап D): порог «поздно открыл смену». shiftStartMinutes — начало рабочего дня (минуты от
  // полуночи: 540 = 9:00); shiftLateGraceMinutes — запас (15 мин → опоздание после 9:15).
  shiftStartMinutes     Int @default(540)
  shiftLateGraceMinutes Int @default(15)
  updatedAt       DateTime @updatedAt
}

// Коэффициент пробок по окну времени суток (PRD §14.3). Набор строк, как KpiRule. Настраивает админ.
// Окна не пересекаются и покрывают сутки; factor берётся по timeFrom задачи (нет времени → дневное окно).
model TrafficWindow {
  id            String @id @default(uuid())
  fromMinutes   Int // минуты от полуночи: 04:00 = 240
  toMinutes     Int // 07:00 = 420
  factorPercent Int // 100 = ×1.0 … 140 = ×1.4
  sortOrder     Int    @default(0)
}

// Идемпотентность офлайн-досылки (офлайн-режим водителя). Без сети водитель выполняет действия
// (статус, комментарий, фото, ведомость), клиент кладёт их в очередь с уникальным ключом
// (Idempotency-Key, uuid v4) и при возврате связи повторяет запрос, пока не получит подтверждение.
// Сервер хранит результат ПЕРВОГО успешного выполнения и при повторе с тем же ключом возвращает
// его, НЕ выполняя действие снова — иначе повтор задвоил бы фото/комментарий или упал бы на матрице
// статусов (например, второй DONE из DONE). userId — владелец ключа (из сессии): чужой ключ → 404
// (та же изоляция, что у задач). Кэшируются только успешные мутации; ошибки не сохраняются (повтор
// может стать валидным). Это не журнал и не первичка — служебный реестр дедупликации, чистится по TTL.
model ProcessedAction {
  key        String    @id // Idempotency-Key с клиента (uuid v4)
  userId     String // кто выполнил действие (из сессии) — изоляция результата
  kind       String // тип действия (диагностика): transition | comment | attachment | work-item | worksheet
  resultJson Json // сохранённый ответ первого успешного выполнения — возвращается при повторе
  occurredAt DateTime? // момент нажатия на телефоне (X-Occurred-At, наблюдаемость 31.07): occurredAt ≪ createdAt = досылка из офлайн-очереди
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

// Настройки интерфейса пользователя: персональная раскладка экранов диспетчера (порядок пулов на
// доске/планировании и свёрнутые пулы). Привязка к пользователю — раскладка одинакова на любом его
// устройстве. Личность пишется ТОЛЬКО из сессии (CLAUDE.md правило 1). value — JSON-массив строк
// (ключи пулов в нужном порядке / свёрнутые ключи). Ключи допустимых настроек — в src/domain/ui-prefs.ts.
model UiPreference {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String // "board.order" | "board.collapsed" | "planning.order"
  value     Json // string[]
  updatedAt DateTime @updatedAt

  @@id([userId, key])
}

// ───────────────────────── Модуль «Станки»: картотека б/у оборудования ─────────────────────────
// Модель данных — ARCHITECTURE §4г, продукт — PRD §16. Решения Артёма 05.08.2026. Полностью
// аддитивно: существующие таблицы не меняются (кроме обратных связей на User и +SERVICE_MANAGER
// в enum Role). Доступ — только ролевой (SERVICE_MANAGER|DISPATCHER|ADMIN), изоляции «по владельцу»
// у модуля нет by design: картотека площадки общая, а не личные задачи.

// Чей станок и зачем он у нас (PRD §16.3). Определяет, какие состояния допустимы.
enum MachineCategory {
  CLIENT // клиентский — привезли в ремонт
  OUR_SALE // наш, на продажу
  OUR_RENTAL // наш, арендный
}

// Состояние станка. Жёсткой матрицы переходов НЕТ (осознанно, PRD §16.3): состояние ставится
// свободно, проверяется только совместимость с категорией (src/domain/machine-status.ts).
// Архивные (обратимые): RELEASED, SOLD, VOIDED. RENTED — НЕ архив, аренда возвращается в цикл.
enum MachineStatus {
  ACCEPTED // принят на площадку
  NEEDS_REPAIR // требует ремонта (продиагностирован)
  IN_REPAIR // в ремонте
  READY // готов
  RENTED // в аренде (только OUR_RENTAL) — возвратное состояние, не архив
  RELEASED // выдан клиенту (только CLIENT) — архив
  SOLD // продан (только OUR_SALE) — архив
  VOIDED // аннулирован: заведён ошибочно (причина обязательна) — архив, вне счётчиков
}

// Раздел картотеки (решение Артёма 15.08.2026). Определяет вкладку интерфейса и — главное —
// область уникальности номера «77-N»: у листогибов и фальцепрокатников свои цепочки номеров,
// поэтому 77-5 может быть одновременно и там, и там (@@unique([family, ourNumber])).
enum EquipmentFamily {
  BENDER // Листогибы: листогиб + роликовый нож
  SEAMER // Фальцепрокатники: фальцепрокатник + размотчик + частотник
}

// Вид оборудования (решение Артёма 07.08.2026, расширен 15.08.2026): всё ведётся в ОДНОЙ картотеке —
// своих полей у ножей и складских позиций нет, общих хватает. Вид ортогонален категории и состоянию,
// но привязан к разделу (KINDS_BY_FAMILY в src/domain/machine-status.ts).
//
// UNCOILER и INVERTER — складские позиции: одна карточка на модель с полем quantity («остатки на
// складе», решение Артёма 15.08.2026). Состояния, категории и сроки к ним не применяются, в
// счётчики состояний они не попадают.
enum EquipmentKind {
  MACHINE // листогиб
  ROLLER_KNIFE // роликовый нож
  SEAMER // фальцепрокатник
  UNCOILER // размотчик — складская позиция, ведётся количеством
  INVERTER // частотник — складская позиция, ведётся количеством
}

// Карточка единицы оборудования.
//
// number — сквозной авто-номер (Postgres sequence machine_number_seq, START 1). С 15.08.2026 он
// ПОЛНОСТЬЮ УБРАН ИЗ ИНТЕРФЕЙСА (решение Артёма: «мы сами будем заводить этот номер»): две
// нумерации рядом путали людей. Колонку и последовательность оставляем в БД — на них стоят живые
// записи и история, а выигрыша от удаления нет.
//
// ourNumber — учётный номер «77-N», который пишут маркером на железе. Заводится руками (система
// подсказывает следующий свободный), доступен ЛЮБОЙ категории, включая клиентскую (решение Артёма
// 15.08.2026 — прежний запрет снят). Уникален В ПРЕДЕЛАХ РАЗДЕЛА: @@unique([family, ourNumber]).
// Дубль ловится этим индексом и отдаётся человеческой ошибкой ввода, а не 500. NULL в Postgres в
// unique не конфликтует, поэтому карточек без номера может быть сколько угодно.
//
// Обязательны при создании ТОЛЬКО category и model (PRD §16.4): старые станки без данных не должны
// блокировать инвентаризацию (урок обязательных контактов в заявках, снято 24.07.2026).
model Machine {
  id             String          @id @default(uuid())
  number         Int             @unique @default(dbgenerated("nextval('machine_number_seq'::regclass)"))
  ourNumber      Int? // «77-N», вводится руками; уникален внутри family
  family         EquipmentFamily @default(BENDER)
  kind           EquipmentKind   @default(MACHINE)
  // Количество на складе. Осмысленно ТОЛЬКО у складских видов (UNCOILER/INVERTER), у остальных
  // всегда 1: карточка = единица железа. Свободный остаток = quantity минус активные резервы
  // комплектов (src/domain/machine-kit.ts).
  quantity       Int             @default(1)
  category       MachineCategory
  status         MachineStatus   @default(ACCEPTED)
  model          String // «ЛБМ 200», «Sorex 2 м»
  configuration  String? // комплектация: нож, машинка, стойка…
  metalThickness String? // «0,7 мм»
  serialNumber   String?
  // Заказчик (клиентские станки). Не обязательны — дозаполняются потом.
  orgName        String?
  contactName    String?
  contactPhone   String?
  // № заказа 1С — ТЕКСТ. Интеграции с 1С нет и не планируется (архив docs/archive/).
  // Клиентский станок без этого номера подсвечивается в сводке янтарным (индикатор, не блокировка).
  invoice1C      String?
  // Ответственный менеджер (Милена/Максим/Михаил/Артём) — обычная связь на User без ограничения роли:
  // это «кто ведёт станок», а не право доступа (права — только ролевые, ARCHITECTURE §6).
  responsibleId  String?
  responsible    User?           @relation("machineResponsible", fields: [responsibleId], references: [id])
  deliveredBy    String? // кто привёз: свободный текст + подсказки (Каширский/Писарев/Султан/Заказчик/Яндекс)
  arrivedAt      DateTime?       @db.Date // дата поступления на площадку
  // Срок готовности/выдачи — универсальный дедлайн (сдача в аренду, обещанный ремонт, отгрузка).
  // Подсветка «просрочен/≤2 дней» считается в src/domain/machine-flags.ts при открытии экрана;
  // пушей и cron по срокам нет (решение Артёма 07.08.2026). В RENTED и архиве срок не «горит».
  dueDate        DateTime?       @db.Date
  isUrgent       Boolean         @default(false)
  defectNotes    String?         @db.Text // дефектовка: что не работает
  location       String? // место на площадке: свободный текст + автоподсказка по введённым значениям
  notes          String?         @db.Text
  voidReason     String? // причина аннулирования — обязательна при status=VOIDED
  diagnosedAt    DateTime? // кнопка «Диагностика проведена»
  lastVerifiedAt DateTime? // кнопка «Подтверждён на месте» (сверка при обходе площадки)
  createdById    String
  createdBy      User            @relation("machineCreator", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  events      MachineEvent[]
  attachments MachineAttachment[]
  kitParts    MachineKitPart[]    @relation("kitHead") // что входит в комплект ЭТОГО станка
  kitOf       MachineKitPart[]    @relation("kitPart") // в чьи комплекты входит эта карточка

  @@unique([family, ourNumber]) // «77-N» уникален внутри раздела (15.08.2026)
  @@index([family, status])
  @@index([category, status])
  @@index([status])
  @@index([updatedAt])
}

// Комплектация (решение Артёма 15.08.2026): «определённый нож идёт к определённому станку», а
// размотчик и частотник — к фальцепрокатнику. Комплект уезжает вместе с головным: при продаже,
// аренде и ремонте состояние переносится на состав — с переспросом и уже включённой галочкой.
//
// Две разные механики в одной таблице, различаются видом part:
//   • уникальный экземпляр (нож, фальцепрокатник) — qty=1 и может быть только в ОДНОМ комплекте;
//   • складская позиция (размотчик, частотник) — входит в любое число комплектов, суммарно не
//     больше остатка; qty — сколько штук зарезервировано за головным.
// Инварианты проверяются в домене (src/domain/machine-kit.ts): условие «нож только в одном
// комплекте» зависит от вида ДРУГОЙ таблицы и частичным индексом Postgres не выражается.
//
// consumedAt — момент списания: продажа головного уменьшает quantity складской позиции и
// проставляет метку, поэтому повторное списание невозможно, а связь остаётся в истории.
model MachineKitPart {
  id         String    @id @default(uuid())
  headId     String // головной агрегат: листогиб или фальцепрокатник
  head       Machine   @relation("kitHead", fields: [headId], references: [id], onDelete: Cascade)
  partId     String // нож / размотчик / частотник
  part       Machine   @relation("kitPart", fields: [partId], references: [id], onDelete: Cascade)
  qty        Int       @default(1) // >1 только у складских позиций
  consumedAt DateTime? // остаток списан вместе с продажей головного
  createdAt  DateTime  @default(now())

  @@unique([headId, partId])
  @@index([partId])
}

// Журнал станка — ТОЛЬКО НА ЗАПИСЬ (CLAUDE.md правило 3), по образцу TaskEvent: события не
// редактируются и не удаляются, исправление ошибки = новое событие. changes хранит «было→стало»
// по ключевым полям правки — чтобы ответить, кто передвинул станок и когда (расследуемость).
model MachineEvent {
  id         String         @id @default(uuid())
  machineId  String
  machine    Machine        @relation(fields: [machineId], references: [id])
  actorId    String
  actor      User           @relation("machineEventActor", fields: [actorId], references: [id])
  kind       String // created | status_change | edit | comment | photo_added | photo_removed
  fromStatus MachineStatus?
  toStatus   MachineStatus?
  comment    String?
  // Диф правки: [{ field, label, from, to }] — только ключевые поля (статус/место/категория/
  // ответственный/номера/заказчик). Пустой массив не пишем: правка без изменений события не создаёт.
  changes    Json?
  at         DateTime       @default(now())

  @@index([machineId, at])
}

// Фото станка. Механика вложений задач один в один: файл лежит в UPLOADS_DIR под серверным
// uuid.ext (клиент имя не задаёт), раздача — только через route handler с проверкой прав, не из
// public/. Создание станка НЕ ждёт фото: карточка сохраняется мгновенно, фото догружаются следом
// с автоповтором (обрыв связи на площадке не теряет ввод).
model MachineAttachment {
  id          String   @id @default(uuid())
  machineId   String
  machine     Machine  @relation(fields: [machineId], references: [id])
  filePath    String // относительный путь в UPLOADS_DIR (uuid.ext) — генерит сервер
  mimeType    String
  sizeBytes   Int
  createdById String // кто загрузил (uuid без навигации, как в Attachment задач)
  createdAt   DateTime @default(now())

  @@index([machineId, createdAt])
}
